<brls:Box
        wireframe="false"
        axis="column"
        width="auto"
        height="auto">
    <brls:Box
            id="mine/history/header"
            width="100%"
            height="60"
            axis="row"
            alignItems="center"
            justifyContent="spaceBetween"
            paddingLeft="20"
            paddingRight="20">

        <brls:Box axis="row" alignItems="center">
            <brls:Box
                    id="mine/history/today"
                    height="36"
                    cornerRadius="18"
                    backgroundColor="@theme/color/grey_1"
                    paddingLeft="16"
                    paddingRight="16"
                    alignItems="center"
                    focusable="true">
                <brls:Label
                        text="@i18n/wiliwili/mine/local_today"
                        fontSize="17"
                        textColor="@theme/font/grey"/>
            </brls:Box>
            <brls:Box
                    id="mine/history/yesterday"
                    height="36"
                    marginLeft="12"
                    cornerRadius="18"
                    backgroundColor="@theme/color/grey_1"
                    paddingLeft="16"
                    paddingRight="16"
                    alignItems="center"
                    focusable="true">
                <brls:Label
                        text="@i18n/wiliwili/mine/local_yesterday"
                        fontSize="17"
                        textColor="@theme/font/grey"/>
            </brls:Box>
            <brls:Box
                    id="mine/history/older"
                    height="36"
                    marginLeft="12"
                    cornerRadius="18"
                    backgroundColor="@theme/color/grey_1"
                    paddingLeft="16"
                    paddingRight="16"
                    alignItems="center"
                    focusable="true">
                <brls:Label
                        text="@i18n/wiliwili/mine/local_earlier"
                        fontSize="17"
                        textColor="@theme/font/grey"/>
            </brls:Box>
        </brls:Box>

        <brls:Box
                id="mine/history/done"
                height="36"
                cornerRadius="18"
                backgroundColor="@theme/color/bilibili"
                paddingLeft="18"
                paddingRight="18"
                alignItems="center"
                focusable="true">
            <brls:Label
                    text="@i18n/wiliwili/mine/local_done"
                    fontSize="17"
                    textColor="#FFFFFF"/>
        </brls:Box>
    </brls:Box>

    <RecyclingGrid
            paddingLeft="20"
            paddingRight="20"
            itemHeight="250"
            grow="1"
            preFetchLine="1"
            spanCount="@style/wiliwili/grid/span/4"
            wireframe="false"
            id="mine/history/recyclingGrid"/>

    <brls:Box
            id="mine/history/footer"
            width="100%"
            height="76"
            axis="row"
            alignItems="center"
            justifyContent="spaceBetween"
            paddingLeft="20"
            paddingRight="20">

        <brls:Box
                id="mine/history/selectall"
                height="40"
                cornerRadius="20"
                backgroundColor="@theme/color/grey_1"
                paddingLeft="20"
                paddingRight="20"
                alignItems="center"
                focusable="true">
            <brls:Label
                    text="@i18n/wiliwili/mine/local_select_all"
                    fontSize="18"
                    textColor="@theme/font/grey"/>
        </brls:Box>

        <brls:Box
                id="mine/history/delete"
                height="40"
                cornerRadius="20"
                backgroundColor="#E05A5A"
                paddingLeft="20"
                paddingRight="20"
                alignItems="center"
                focusable="true">
            <brls:Label
                    text="@i18n/wiliwili/mine/local_delete"
                    fontSize="18"
                    textColor="#FFFFFF"/>
        </brls:Box>
    </brls:Box>
</brls:Box>
